{
  "name": "mybook",
  "source": "D:/books/mybook.epub",

  "chunk_chars": 60000,
  "quote_open": ["“", "「", "『"],
  "quote_close": ["”", "」", "』"],
  "person": "third",
  "protagonist": "",
  "vol_unit_word": "卷",

  "names": ["主角", "女主", "配角甲", "配角乙"],

  "drop_headings": ["简介", "制作信息", "封面及彩页"],

  "hard_settings": [
    "这里列 5-10 条不可改的世界观底线（谁是谁、能力规则、不能违反的因果）"
  ],
  "if_points": [
    "某个可以改一笔就引发走向变化的节点：改什么 → 会怎样"
  ],

  "llm": {
    "backend": "openai",
    "base_url": "http://127.0.0.1:8000/v1",
    "api_key_env": "OPENAI_API_KEY",
    "model": "your-model",
    "temperature": 0.3,
    "max_tokens": 4096,
    "timeout": 600,
    "retries": 3,
    "concurrency": 16
  },

  "_llm_子代理示例": {
    "backend": "command",
    "command": "my-agent -p --no-session --mode text --tools read,write < {prompt_file} > {out_file}",
    "concurrency": 50,
    "timeout": 1800,
    "retries": 3,
    "_说明": "一个子代理一片，各自独立上下文；只给 read,write，别给联网。并发数按你的额度定，实测 25-78 路可用。详见 docs/PARALLEL.md"
  },

  "_llm_云API示例": {
    "backend": "openai",
    "base_url": "https://api.example.com/v1",
    "model": "your-model",
    "concurrency": 16,
    "_说明": "撞限流会自动退避重试，但速度会掉；先 --only 1,2,3 --par 8 试"
  }
}
